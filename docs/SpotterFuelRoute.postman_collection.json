{
  "info": {
    "name": "Spotter Fuel Route",
    "description": "Fuel route optimizer demo. Run in order against `manage.py runserver` (base_url). Requests 1, 3, 5, 6 and 7 may each make one real ORS call the first time.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. NY → LA (first call)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test('has fuel stops and a total', () => { pm.expect(b.summary.stop_count).to.be.above(0); pm.expect(b.summary.total_fuel_cost).to.be.a('string'); });",
              "pm.test('route geometry is last', () => pm.expect(Object.keys(b).pop()).to.eql('route'));",
              "pm.collectionVariables.set('map_url', b.map_url);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"New York, NY\",\n  \"finish\": \"Los Angeles, CA\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/route/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "route",
            ""
          ]
        },
        "description": "New route: 1 ORS directions call on a fresh server (0 if already cached). Saves map_url for request 9."
      }
    },
    {
      "name": "2. NY → LA again (cached)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test('0 external calls', () => pm.expect(b.external_api_calls).to.eql(0));",
              "pm.test('cached', () => pm.expect(b.cached).to.eql(true));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"New York, NY\",\n  \"finish\": \"Los Angeles, CA\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/route/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "route",
            ""
          ]
        },
        "description": "Same request: served from the plan cache, 0 external calls."
      }
    },
    {
      "name": "3. Dallas → Austin, full tank",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test('0 stops', () => pm.expect(b.summary.stop_count).to.eql(0));",
              "pm.test('cost 0.00', () => pm.expect(b.summary.total_fuel_cost).to.eql('0.00'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"Dallas, TX\",\n  \"finish\": \"Austin, TX\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/route/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "route",
            ""
          ]
        },
        "description": "195.6 mi on a full 50 gal tank (500 mi range): no stops, cost 0.00."
      }
    },
    {
      "name": "4. Dallas → Austin, empty tank",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test('buys fuel', () => pm.expect(b.summary.stop_count).to.be.above(0));",
              "pm.test('first stop at mile 0', () => pm.expect(b.fuel_stops[0].mile_marker).to.eql(0));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"Dallas, TX\",\n  \"finish\": \"Austin, TX\",\n  \"start_fuel_gallons\": 0\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/route/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "route",
            ""
          ]
        },
        "description": "start_fuel_gallons 0: works because a Dallas station sits at mile 0 (same city centroid as the start). Route is cached from request 3."
      }
    },
    {
      "name": "5. Honolulu → LA (no road route)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('422', () => pm.response.to.have.status(422));",
              "pm.test('no_route', () => pm.expect(pm.response.json().error.code).to.eql('no_route'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"Honolulu, HI\",\n  \"finish\": \"Los Angeles, CA\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/route/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "route",
            ""
          ]
        },
        "description": "ORS error 2009 → 422 no_route."
      }
    },
    {
      "name": "6. Gulf of Mexico point → Houston",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400', () => pm.response.to.have.status(400));",
              "const e = pm.response.json().error;",
              "pm.test('unroutable_point at start', () => { pm.expect(e.code).to.eql('unroutable_point'); pm.expect(e.point).to.eql('start'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"27.0,-90.0\",\n  \"finish\": \"Houston, TX\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/route/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "route",
            ""
          ]
        },
        "description": "Coordinate in the sea: ORS error 2010 → 400 unroutable_point (point: start)."
      }
    },
    {
      "name": "7. Unknown city",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400', () => pm.response.to.have.status(400));",
              "pm.test('invalid_location', () => pm.expect(pm.response.json().error.code).to.eql('invalid_location'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"Faketown, TX\",\n  \"finish\": \"Dallas, TX\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/route/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "route",
            ""
          ]
        },
        "description": "Not in the offline gazetteer; the ORS geocode fallback finds nothing → 400 invalid_location (the miss is cached for 1 day)."
      }
    },
    {
      "name": "8. Validation error: start_fuel_gallons 51",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400', () => pm.response.to.have.status(400));",
              "const e = pm.response.json().error;",
              "pm.test('invalid_request on start_fuel_gallons', () => { pm.expect(e.code).to.eql('invalid_request'); pm.expect(e.fields).to.have.property('start_fuel_gallons'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"New York, NY\",\n  \"finish\": \"Los Angeles, CA\",\n  \"start_fuel_gallons\": 51\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/route/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "route",
            ""
          ]
        },
        "description": "Above the 50 gal tank → 400 invalid_request with per-field messages."
      }
    },
    {
      "name": "9. Map (NY → LA)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('HTML page', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('text/html'));",
              "pm.test('0 external calls', () => pm.expect(pm.response.headers.get('X-External-API-Calls')).to.eql('0'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{map_url}}",
        "description": "Opens map_url saved by request 1: Leaflet HTML from the plan cache, 0 external calls. Open in a browser to see the map."
      }
    },
    {
      "name": "10. Health",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test('ok with geocoded stations', () => { pm.expect(b.ok).to.eql(true); pm.expect(b.stations_geocoded).to.be.above(0); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/health/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "health",
            ""
          ]
        },
        "description": "Row counts and the stations version."
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "map_url",
      "value": ""
    }
  ]
}
